docs/
inst/doc
/EFT/*

# Claude Code: keep the project instructions, ignore local session state.
# CLAUDE.md lives here rather than at the top level so pkgdown does not pick
# it up as a page alongside README.md.
.claude/*
!.claude/CLAUDE.md
# The notes are kept too: the measured numbers and what the README used to say.
# A file cannot be re-included under an ignored directory, so the directory is
# re-included and its contents ignored again around the notes.
!.claude/notes/
.claude/notes/*
!.claude/notes/*.md

# The hosted Area Master File archives, built by data-raw/amf_archives.R.
data-raw/amf_archives/
